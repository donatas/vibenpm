{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibenpm.dev/schemas/agent-package.schema.json",
  "title": "vibenpm package manifest",
  "description": "Metadata for a JavaScript package listed in the vibenpm catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "owner"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Lowercase owner identifier used in package paths and URLs.",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "license": {
      "type": "string",
      "maxLength": 64
    },
    "keywords": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      }
    },
    "entrypoints": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.(?:js|mjs|cjs|ts|mts|cts)$"
      }
    }
  }
}
